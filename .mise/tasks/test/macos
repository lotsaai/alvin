#!/usr/bin/env bash
# shellcheck source=/dev/null

#MISE description="Run the app's NSH tests on the macOS host (needs a window server)"
#MISE depends=["nsh:prep", "build:debug"]

proj_dir=$(git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

source "$(dirname "$0")/server.sh"
server_start

nsh test crates/heyday-app --target macos "$@"
