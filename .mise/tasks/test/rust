#!/usr/bin/env bash

#MISE description="Run the Rust tests for this project"
#MISE sources=["Cargo.toml", "Cargo.lock", "crates/**/*.rs", "crates/**/Cargo.toml"]

proj_dir=$(git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

# alvin-protocol's `server` half is part of the contract, so its tests run with it enabled.
cargo nextest run --cargo-quiet --show-progress=bar --status-level=slow --features alvin-protocol/server "$@"
