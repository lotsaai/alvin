#!/usr/bin/env bash

#MISE description="Run the Rust tests for this project"
#MISE depends=["build:debug", "prepare:speech-model"]
#MISE secrets=["OPENROUTER_API_KEY"]
#MISE sources=["Cargo.toml", "Cargo.lock", "crates/**/*.rs", "crates/**/Cargo.toml", "vendor/**"]

proj_dir=$(git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

# alvin-protocol has two halves: the default client half and the `server` half. One run covers both by naming the feature.
cargo nextest run --cargo-quiet --show-progress=bar --status-level=slow --features alvin-protocol/server "$@"
