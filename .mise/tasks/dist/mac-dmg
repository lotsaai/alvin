#!/usr/bin/env bash

#MISE description="Assemble the Heyday macOS .app and .dmg for distribution into target/dist/mac"
#MISE depends=["dist:mac-app"]
#MISE sources=["Cargo.toml", "Cargo.lock", "crates/**/*.rs", "crates/**/Cargo.toml", "crates/heyday-app/nsh.json"]

proj_dir=$(git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

app="target/dist/mac/Heyday.app"
version=$(python3 -c 'import json;print(json.load(open("crates/heyday-app/nsh.json"))["version"])')
arch=$(uname -m)
dmg="target/dist/mac/Heyday_${version}_${arch}.dmg"

[ -d "$app" ] || {
	echo "missing $app (run mise dist:mac-app)" >&2
	exit 1
}
rm -f "$dmg"

# A Developer ID and notarization run in the release pipeline; this image
# holds the ad-hoc signed .app. Needs a host with disk-image devices: a CI
# runner has them, a sandbox without them fails here.
diskutil image create from "$app" --volumeName Heyday --format UDZO "$dmg"
echo "packaged $dmg"
