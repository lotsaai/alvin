#!/usr/bin/env bash

#MISE description="Assemble the Heyday iOS .ipa (device) into target/dist/ios via nsh package"
#MISE sources=["Cargo.toml", "Cargo.lock", "crates/**/*.rs", "crates/**/Cargo.toml", "crates/heyday-app/nsh.json"]
#MISE outputs=["target/dist/ios/Heyday.ipa"]
#MISE depends=["nsh:prep"]

proj_dir=$(git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

# Devices only: --sign pairs the app with a distribution identity; without it
# the .app is unsigned and cannot install.
nsh package crates/heyday-app --target ios --out target/dist/ios "$@"
