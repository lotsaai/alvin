#!/usr/bin/env bash

#MISE description="Assemble the Heyday web site into target/dist/web via nsh package"
#MISE sources=["Cargo.toml", "Cargo.lock", "crates/**/*.rs", "crates/**/Cargo.toml", "crates/heyday-app/nsh.json"]
#MISE outputs=["target/dist/web/Heyday/index.html"]
#MISE depends=["nsh:prep"]

proj_dir=$(git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

nsh package crates/heyday-app --target web --out target/dist/web "$@"
