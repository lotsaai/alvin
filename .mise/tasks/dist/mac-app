#!/usr/bin/env bash

#MISE description="Assemble the Heyday macOS .app (ad-hoc signed) into target/dist/mac via nsh package"
#MISE sources=["Cargo.toml", "Cargo.lock", "crates/**/*.rs", "crates/**/Cargo.toml", "crates/heyday-app/nsh.json"]
#MISE outputs=["target/dist/mac/Heyday.app/Contents/MacOS/Heyday"]
#MISE depends=["nsh:prep"]

proj_dir=$(git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

# Local-testing bundle. A Developer ID and notarization credentials, when the
# distribution channel needs them, are set in the release pipeline.
nsh package crates/heyday-app --target macos --out target/dist/mac "$@"
