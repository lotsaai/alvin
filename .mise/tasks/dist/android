#!/usr/bin/env bash

#MISE description="Assemble the Heyday Android .apk into target/dist/android via nsh package"
#MISE sources=["Cargo.toml", "Cargo.lock", "crates/**/*.rs", "crates/**/Cargo.toml", "crates/heyday-app/nsh.json"]
#MISE outputs=["target/dist/android/Heyday.apk"]
#MISE depends=["nsh:prep"]

proj_dir=$(git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

# Signed with the debug key: store releases pass --keystore, --key-alias and
# NSH_KEYSTORE_PASSWORD.
nsh package crates/heyday-app --target android --out target/dist/android "$@"
