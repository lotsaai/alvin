#!/usr/bin/env bash

#MISE description="Build and package unsigned release artifacts"
#MISE depends=["build:release"]

set -euo pipefail

proj_dir=$(git rev-parse --show-toplevel)
cd "$proj_dir"

mkdir -p target/distrib
stage=$(mktemp -d "${TMPDIR:-/tmp}/alvin-release.XXXXXX")
trap 'rm -rf "$stage"' EXIT
cp crates/alvin-stt/licenses/nemotron-3.5-NOTICE.txt "$stage/"

case "$(uname -s)-$(uname -m)" in
Darwin-arm64)
	cp target/release/alvind "$stage/"
	ALVIN_PACKAGE_PROFILE=release bash .mise/tasks/package
	cp -R target/release/Alvin.app "$stage/"
	ditto -c -k --sequesterRsrc "$stage" target/distrib/alvin-aarch64-apple-darwin.zip
	;;
Linux-x86_64)
	cp target/release/alvind "$stage/"
	cp target/release/alvin-app "$stage/"
	tar -czf target/distrib/alvin-x86_64-unknown-linux-gnu.tar.gz -C "$stage" .
	;;
MINGW* | MSYS* | CYGWIN*)
	host=$(rustc -vV)
	host=${host#*$'\n'host: }
	host=${host%%$'\n'*}
	case "$host" in
	x86_64-pc-windows-msvc | aarch64-pc-windows-msvc) ;;
	*)
		printf 'Unsupported Windows Rust host: %s\n' "$host" >&2
		exit 1
		;;
	esac
	release_dir="${CARGO_TARGET_DIR:-target}/release"
	cp "$release_dir/alvin-app.exe" "$release_dir/alvind.exe" "$stage/"
	if [[ ! -f "$release_dir/DirectML.dll" ]]; then
		printf 'Missing required runtime DLL: %s/DirectML.dll\n' "$release_dir" >&2
		exit 1
	fi
	cp "$release_dir"/*.dll "$stage/"
	cp crates/alvin-stt/licenses/DirectML-LICENSE.txt "$stage/"
	ALVIN_RELEASE_STAGE=$(cygpath -w "$stage")
	ALVIN_RELEASE_ZIP=$(cygpath -w "$proj_dir/target/distrib/alvin-$host.zip")
	export ALVIN_RELEASE_STAGE ALVIN_RELEASE_ZIP
	powershell.exe -NoProfile -Command "Compress-Archive -Path (Join-Path \$env:ALVIN_RELEASE_STAGE '*') -DestinationPath \$env:ALVIN_RELEASE_ZIP -Force"
	;;
*)
	printf 'Unsupported release platform: %s-%s\n' "$(uname -s)" "$(uname -m)" >&2
	exit 1
	;;
esac
