#!/usr/bin/env bash

#MISE description="Run the desktop app"
#MISE depends=["build:debug"]
#MISE daemons=["gateway"]
#MISE sources=["Cargo.toml", "Cargo.lock", "crates/**/*.rs", "crates/**/Cargo.toml", "crates/alvin-stt/licenses/nemotron-3.5-NOTICE.txt", "assets/chipmunk-mascot.webp", ".mise/tasks/package"]

proj_dir=$(git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

if [[ $(uname -s) == Darwin ]]; then
	mise run package
	exec "$proj_dir/target/debug/Alvin.app/Contents/MacOS/alvin-app" "$@"
fi

exec "$proj_dir/target/debug/alvin-app" "$@"
